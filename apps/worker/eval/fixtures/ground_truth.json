{
  "format_version": 1,
  "box_format": "[x, y, w, h], normalized 0..1 against the UPRIGHT (EXIF-orientation-applied) image, top-left origin",
  "absent_convention": "null = the field's live display is not visible/legible in that image; null fields are excluded from scoring (and a field null in the reference is not part of the template)",
  "gt_convention": "Tight box on the LIVE readout window: the display glass that holds the changing characters (inner edge of the bezel/frame). Never the printed VOLT/AMP labels, nameplates, or bezel.",
  "provenance": "Real frames from one lab-bench batch, cropped to the bench region; background/bystanders/hands flat-grey redacted (see README). exif6 + lighting fixtures are synthesized by eval/make_fixtures.py.",
  "reference": "reference.jpg",
  "fields": [
    {
      "name": "psu_volt_display",
      "semantic_description": "Left-hand 7-segment LCD window on the front panel of the black bench DC power supply: dark digits on a pale grey-green glass showing the output voltage with one decimal place (e.g. '10.7'). It is the left of two side-by-side LCD windows in the recessed black display bezel across the top of the panel; the printed 'VOLT' marking sits on the bezel just below it."
    },
    {
      "name": "psu_amp_display",
      "semantic_description": "Right-hand 7-segment LCD window on the same black DC power supply, immediately right of the voltage window, showing the output current with two decimal places (e.g. '0.06'); a small red CURRENT LIMITED indicator sits to its right and the printed 'AMP.' marking below it."
    },
    {
      "name": "handheld_display",
      "semantic_description": "Large monochrome LCD at the top of the orange-and-green Extech EX410A handheld multimeter, showing a 4-digit reading with a decimal point in tall black 7-segment digits on a grey background, framed by the dark green bezel above the 'EXTECH' logo and the F/C/HOLD buttons."
    },
    {
      "name": "bench_meter_display",
      "semantic_description": "Wide segmented readout window across the upper front panel of the beige HP 3468A bench multimeter, showing a signed 5.5-digit value (e.g. '+0.06467') followed by the function annunciator ('ADC') in dark segmented characters behind a tinted glass strip, below the '3468A MULTIMETER' nameplate and above the rows of grey push-buttons."
    }
  ],

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=easylab

# Direct Postgres connection (port 5432) — used by FastAPI worker via asyncpg
# Found in: Supabase dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ── AI ────────────────────────────────────────────────────────────────────────
# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash

# ── Internal service auth ─────────────────────────────────────────────────────
# Shared secret between Next.js and FastAPI for /internal/* routes
# Generate with: openssl rand -hex 32
INTERNAL_SHARED_SECRET=change-me-generate-with-openssl-rand-hex-32

# ── Worker tuning ─────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
IMAGE_CONCURRENCY=5
CONFIDENCE_THRESHOLD=0.7

# ── Spend controls ────────────────────────────────────────────────────────────
MAX_JOBS_PER_WORKSPACE_PER_DAY=5
MAX_IMAGES_PER_WORKSPACE_PER_DAY=200
GLOBAL_DAILY_TOKEN_BUDGET=50000000
WORKSPACE_DAILY_TOKEN_BUDGET=2000000

# ── Next.js (apps/web/.env.local) ─────────────────────────────────────────────
# These go in apps/web/.env.local — NOT here
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# SUPABASE_URL=           (same as above)
# SUPABASE_SERVICE_ROLE_KEY=  (same — server-only, never NEXT_PUBLIC_)
# SUPABASE_STORAGE_BUCKET=    (same)
# FASTAPI_INTERNAL_URL=http://worker:8000   (use http://localhost:8000 outside Docker)
# INTERNAL_SHARED_SECRET=     (same as above)
#
# Browser-side Realtime (optional — process page falls back to polling if absent):
# NEXT_PUBLIC_SUPABASE_URL=         (same as SUPABASE_URL above)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=    (anon/public key from Supabase dashboard)
